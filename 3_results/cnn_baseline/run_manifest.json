 "subset": null,
 "deviations": [
  {
   "item": "early stopping",
   "detail": "the original guard (if early_stopping(score): if early_stopping.early_stop: break) could never trigger; here training stops when patience (10) is exhausted"
  },
  {
   "item": "best state",
   "detail": "the original best_model_state was a shallow copy of the live state_dict; here a detached copy is restored"
  },
  {
   "item": "early-stopping set",
   "detail": "patient-disjoint inner validation split (GroupShuffleSplit 0.15, seed 42) instead of the chunk-level 80/20 re-split of pooled train+val chunks"
  },
  {
   "item": "online augmentation",
   "detail": "applied to cached MFCC maps in the feature domain. Gain: exact, c0 offset sqrt(n_mels)*20*log10(g) in every frame, deltas unchanged (asserted at runtime). Shift: approximate, circular roll of round(shift/hop) frames. Against an audio-domain roll with re-extraction, a whole-frame shift differs in 6 to 8 frames at each edge (centred reflect padding, delta interpolation); a sub-frame shift (the general case) differs in every frame by a small amount (rms about 0.02 to 0.07 standardised units, up to 3.3 at the edges); |shift| below 80 samples (about 10% of the draws) rounds to zero frames and does nothing"
  },
  {
   "item": "feature cache",
   "detail": "MFCC maps stored standardised in float16 with float32 mean/std; fresh and resumed runs use the same round-tripped values (max error 3.9e-03 map-std units)"
  },
  {
   "item": "joint balancing",
   "detail": "vectorised planner with the verbatim selection rule (checked against the pandas loop); pool restricted to chunks with all three labels valid before balancing (the original dropped them after balancing, at load time)"
  },
  {
   "item": "batching",
   "detail": "shuffled GPU-resident tensors instead of a DataLoader (shuffle=True, batch 64, single-sample last batch skipped as BatchNorm requires)"
  },
  {
   "item": "scoring",
   "detail": "recording level (mean chunk softmax, argmax) is primary; chunk level reported alongside"
  }
 ],
